# Python environments and bytecode
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test, lint, and coverage output
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local configuration and credentials
.env
.env.*
!.env.example
.kaggle/
